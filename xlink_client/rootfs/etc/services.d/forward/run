#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Add-on: xLink Client (Tailscale)
# Port forwarder via socat
# ==============================================================================

bashio::log.info "Starting port forwarder..."

TARGET=""
if bashio::config.has_value 'forward'; then
    TARGET=$(bashio::config 'forward')
else
    bashio::log.info "No forward target configured, skipping port forwarder."
    exit 0
fi

bashio::log.info "Forwarding: ${TARGET}"

# Forward from Tailscale port to target
exec socat TCP4-LISTEN:8080,fork,reuseaddr "TCP4:${TARGET}",reuseaddr
